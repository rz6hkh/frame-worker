# Скопировать в .env рядом с compose Immich и заполнить.

FRAME_DB_LOCATION=/var/lib/frame-postgres
FRAME_DB_PASSWORD=

# Архив: путь как его видит хост
ARHIV_HOST=/mnt/photos
# Карантин - на том же диске, вне папки архива, иначе его будет индексировать Immich
QUARANTINE_HOST=/mnt/photos_quarantine
# Рабочие файлы: контактные листы, копии конфигов
OUT_HOST=/var/lib/frame-worker/out

# Папки архива, откуда берём снимки, через |
SOURCES=Photos|Videos
# Типы людей, через |. Тип пишется последним словом имени человека в Immich.
PEOPLE_TYPES=близкие|коллеги|не показывать
# Человек с этим типом убирает снимок из показа целиком
HIDE_TYPE=не показывать
# Альбом-мусорка
NOSHOW_ALBUM=Не показывать

OLLAMA=http://ollama:11434
MODEL=qwen3.5:4b
